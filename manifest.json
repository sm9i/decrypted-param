{
  "manifest_version": 3,
  "name": "decrypted",
  "version": "0.1.0",
  "description": "Provides a decrypted panel in Chrome DevTools.",
  "devtools_page": "devtools.html",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js", "page-unhook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
